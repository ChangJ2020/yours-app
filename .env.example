# ==========================================================================
# Yours App (YA) · 环境变量示例
# --------------------------------------------------------------------------
# 用法：复制本文件为 `.env.local`，填入真实配置后重启 `npm run dev`。
#      `.env.local` 已被 .gitignore 忽略，不会提交到仓库。
#
# 作用：把 AI 对话接口配置交给环境变量统一管理，用户打开页面即可直接对话，
#      不必在界面上手填（界面里的 ⚙️ 面板仍可覆盖，但环境变量优先级最高）。
# ==========================================================================

# 是否启用 AI 对话（true/false）。只要下面三项填了值，默认即为启用。
VITE_YA_LLM_ENABLED=true

# OpenAI 兼容接口地址。可填基础地址，程序会自动补 /chat/completions
#   DeepSeek : https://api.deepseek.com/v1
#   OpenAI   : https://api.openai.com/v1
#   本地 Ollama: http://localhost:11434/v1   （无需 Key，随便填一个非空值即可）
VITE_YA_LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名称，例如 deepseek-chat / gpt-4o-mini / qwen-plus / llama3.1
VITE_YA_LLM_MODEL=

# API Key
VITE_YA_LLM_API_KEY=

# 可选：采样温度（默认 0.3，越低越稳定，适合生成结构化配置）
VITE_YA_LLM_TEMPERATURE=0.3

# 可选：是否流式输出（默认 true）
VITE_YA_LLM_STREAM=true

# ==========================================================================
# Yours App (YA) · Git 忽略规则
# ==========================================================================

# ------------------------------- 依赖与构建产物 -------------------------------
node_modules/
dist/
dist-ssr/
*.local

# IDE 配置
.idea/
*.iml
*.ipr
*.iws
out/

# 本地 npm 缓存（本工程安装依赖时使用了 --cache .npmcache，避免污染全局缓存）
.npmcache/

# ---------------------------- 端到端验证产物（可复现） ----------------------------
# 由 `npm run verify` 生成：无头浏览器截图 + 结果报告
verify-shots/
.chrome-verify-profile/
*.tmpdir/

# --------------------------------- 日志与排查 ---------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
debug.log*

# --------------------------------- 编辑器/系统 --------------------------------
# 编辑器与操作系统产生的文件因团队而异，默认忽略；若需共享配置可自行放行
.DS_Store
Thumbs.db
Desktop.ini

# --------------------------------- 环境变量 -----------------------------------
# 本工程不需要 .env 即可运行（模型接口配置保存在浏览器本地）；
# 若后续引入本地服务，可把密钥写入 .env，此处已默认忽略
.env
.env.*
!.env.example

# ------------------------------- 缓存与临时文件 -------------------------------
.cache/
.temp/
*.tsbuildinfo
.eslintcache
.vite/
